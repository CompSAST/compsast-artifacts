a3497f79f2e17d3b5b2902c55f13ef62e11b163cad7ee8d95e3_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00657.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":59,"endLine":53,"snippet":{"text":"\t\t\tunpickled = pickle.loads(base64.urlsafe_b64decode(bar))"},"startColumn":16,"startLine":53}}}],"message":{"text":"Avoid using `pickle`, which is known to lead to code execution vulnerabilities. When unpickling, the serialized data could be manipulated to run arbitrary code. Instead, consider serializing the relevant data as JSON or a similar text-based serialization format."},"properties":{},"ruleId":"python.lang.security.deserialization.pickle.avoid-pickle"},{"fingerprints":{"matchBasedId/v1":"282e306ba98662dab10d96a4e4adf6a759944fba02965b1f6041e9670a7f4e66fc115854e2e7cbe047f02cc567c85c48a91bbafd0f26bc9b2ee7a4f2ae4cdbed_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00658.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":53,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":53}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"2b3ac21dfdc1291eff9491f626c9988470e8ff8c6803c89a185addbe17d6dbd3a055e904ce8bf3bd400d5db36996a9fa64fa01ac201f36358def07ad7211145e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00658.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":53,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":53}}}],"message":{"text":"Detected a possible YAML deserialization vulnerability. `yaml.unsafe_load`, `yaml.Loader`, `yaml.CLoader`, and `yaml.UnsafeLoader` are all known to be unsafe methods of deserializing YAML. An attacker with control over the YAML input could create special YAML input that allows the attacker to run arbitrary Python code. This would allow the attacker to steal files, download and install malware, or otherwise take over the machine. Use `yaml.safe_load` or `yaml.SafeLoader` instead."},"properties":{},"ruleId":"python.lang.security.deserialization.avoid-pyyaml-load.avoid-pyyaml-load"},{"fingerprints":{"matchBasedId/v1":"6cd20168a0daee7ca3ca04e0c6f36d5914725394a70d834bb86298c5d287b5e05013991ff2a87300a8c42cd36c4c06a22b9d815f8c861b3ae9758c455589bc31_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00674.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":49,"snippet":{"text":"\t\t\troot = ET.parse(f'{helpers.utils.RES_DIR}/employees.xml')"},"startColumn":11,"startLine":49}}}],"message":{"text":"The native Python `xml` library is vulnerable to XML External Entity (XXE) attacks.  These attacks can leak confidential data and \"XML bombs\" can cause denial of service. Do not use this library to parse untrusted input. Instead  the Python documentation recommends using `defusedxml`."},"properties":{},"ruleId":"python.lang.security.use-defused-xml-parse.use-defused-xml-parse"},{"fingerprints":{"matchBasedId/v1":"dc320f89a7c2111a4a1011b384d680f72f5a53cb410b0f78ba68de577f1e67f5cde1ce6fb3d2ef3f92f195abe0663fa465640f5411a3d4053c86c2e2a29549e9_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00675.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":44,"snippet":{"text":"\t\t\troot = ET.parse(f'{helpers.utils.RES_DIR}/employees.xml')"},"startColumn":11,"startLine":44}}}],"message":{"text":"The native Python `xml` library is vulnerable to XML External Entity (XXE) attacks.  These attacks can leak confidential data and \"XML bombs\" can cause denial of service. Do not use this library to parse untrusted input. Instead  the Python documentation recommends using `defusedxml`."},"properties":{},"ruleId":"python.lang.security.use-defused-xml-parse.use-defused-xml-parse"},{"fingerprints":{"matchBasedId/v1":"4587fe2968f7e14b5412bf529e22465406be583eeccbdbac3689deee722ba687e7c2ad337f48bdf5a08155f4dfcb0416ab74b4342ef5f178fd119d4cc0a388bf_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00676.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":49,"snippet":{"text":"\t\t\troot = ET.parse(f'{helpers.utils.RES_DIR}/employees.xml')"},"startColumn":11,"startLine":49}}}],"message":{"text":"The native Python `xml` library is vulnerable to XML External Entity (XXE) attacks.  These attacks can leak confidential data and \"XML bombs\" can cause denial of service. Do not use this library to parse untrusted input. Instead  the Python documentation recommends using `defusedxml`."},"properties":{},"ruleId":"python.lang.security.use-defused-xml-parse.use-defused-xml-parse"},{"fingerprints":{"matchBasedId/v1":"301f87be51227c119091c3a507673076d1330d7716f918769be867840a6374779018c3b3eb576b87e0cc33bce390396d204681219ae05e21beda085345d28520_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00677.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":45,"snippet":{"text":"\t\t\troot = ET.parse(f'{helpers.utils.RES_DIR}/employees.xml')"},"startColumn":11,"startLine":45}}}],"message":{"text":"The native Python `xml` library is vulnerable to XML External Entity (XXE) attacks.  These attacks can leak confidential data and \"XML bombs\" can cause denial of service. Do not use this library to parse untrusted input. Instead  the Python documentation recommends using `defusedxml`."},"properties":{},"ruleId":"python.lang.security.use-defused-xml-parse.use-defused-xml-parse"},{"fingerprints":{"matchBasedId/v1":"