  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Joern",
          "version": "2.0.0",
          "informationUri": "https://joern.io",
          "rules": [
            {
              "id": "CWE484-omitted-break-in-switch",
              "name": "OmittedBreakInSwitch",
              "shortDescription": {
                "text": "CWE-484: Omitted Break Statement in Switch"
              },
              "fullDescription": {
                "text": "A case in a switch statement falls through to the next case without a break, return, or goto statement, which may cause unintended execution."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "CWE-484",
                  "security"
                ],
                "precision": "high"
              }
            },
            {
              "id": "CWE789-uncontrolled-memory-allocation",
              "name": "UncontrolledMemoryAllocation",
              "shortDescription": {
                "text": "CWE-789: Uncontrolled Memory Allocation"
              },
              "fullDescription": {
                "text": "The size of a memory allocation (malloc/calloc/realloc) is derived from external input without an upper bound check, which may lead to denial of service or integer overflow."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "CWE-789",
                  "security"
                ],
                "precision": "medium"
              }
            }
          ]
        }
      },
