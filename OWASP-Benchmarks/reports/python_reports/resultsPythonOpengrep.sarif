n":14,"startLine":52}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"b3af9b38822adcb5b446aa4756d3f4e3debc78e2106013ef5a50037a769a3e00289b3b21d5461af747ba58642e064b9ff525e013b67cafab907c78d907b6dbfe_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00884.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":72,"endLine":47,"snippet":{"text":"\t\tRESPONSE = make_response((RESPONSE, {'yourBenchmarkTest00884': bar}))"},"startColumn":14,"startLine":47}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"b36255c5fdf0a53a16693f0461cb52c841a648721532b89cb45636acf347a753db312b7f6c47d7163f3ebcb35f5c29c645f675827ebafdadea254c02ce55550c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00885.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":59,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":59}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"2f41e80695bf98a478e6779e642e5628bd59b098ea74b19b9ce7d9d7a60891b3ebbc41b8d3c0ba5c4080aa9d54be190414baac04f57aed095b57be73da063d6d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00885.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":63,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn":3,"startLine":60}}}],"message":{"text":"Found a Flask cookie with insecurely configured properties.  By default the secure, httponly and samesite ar configured insecurely. cookies should be handled securely by setting `secure=True`, `httponly=True`, and `samesite='Lax'` in response.set_cookie(...). If these parameters are not properly set, your cookies are not properly protected and are at risk of being stolen by an attacker. Include the `secure=True`, `httponly=True`, `samesite='Lax'` arguments or set these to be true in the Flask configuration."},"properties":{},"ruleId":"python.flask.security.audit.secure-set-cookie.secure-set-cookie"},{"fingerprints":{"matchBasedId/v1":"63075d0713ebe75feaaca2d64c60cedff4df4d3e50c98176797f1f1a6bc068d441237c2b09c42896d3cb0701203c85459e2ff85077ff6c8af5eef6226d28a286_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00886.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":59,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":59}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"4edb34bd663471f6b2c5978d34126edf3d24d19e9c41e10959a85e2fa7743bc2f0c267f70df57d7ab51df1e8e4c9aa07284d6575ae0c1f924545dc7790c15c8f_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00886.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":63,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn":3,"startLine":60}}}],"message":{"text":"Found a Flask cookie with insecurely configured properties.  By default the secure, httponly and samesite ar configured insecurely. cookies should be handled securely by setting `secure=True`, `httponly=True`, and `samesite='Lax'` in response.set_cookie(...). If these parameters are not properly set, your cookies are not properly protected and are at risk of being stolen by an attacker. Include the `secure=True`, `httponly=True`, `samesite='Lax'` arguments or set these to be true in the Flask configuration."},"properties":{},"ruleId":"python.flask.security.audit.secure-set-cookie.secure-set-cookie"},{"fingerprints":{"matchBasedId/v1":"427fae1df2c391bfa4be3185808056b0c1049cf77b1498fdf8d4ed39271aa2aafec8d22e5eda7a1f7a02c7bd565c57261c01240f71236f515e1f1e5143126121_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/