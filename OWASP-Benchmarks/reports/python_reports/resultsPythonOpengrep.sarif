nt can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.exec-detected.exec-detected"},{"fingerprints":{"matchBasedId/v1":"cfc94abe19354f4f56fe2d9a5596613f4473364002bd2dbca474313c81bd06c6779404a9bb6dde6ff10daa9939a5a2c7fd14926bfb36a4006e81767d0439e9ac_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00431.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":44,"endLine":51,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":40,"startLine":51}}}],"message":{"text":"Found 'subprocess' function 'run' with 'shell=True'. This is dangerous because this call will spawn the command using a shell process. Doing so propagates current shell settings and variables, which makes it much easier for a malicious actor to execute commands. Use 'shell=False' instead."},"properties":{},"ruleId":"python.lang.security.audit.subprocess-shell-true.subprocess-shell-true"},{"fingerprints":{"matchBasedId/v1":"4682cc598e80d6562cbfb5169d047a1aefabffac255f289945927c6a2a34d42bdf1ff078f450f7d85f615d5c5bfefc913f6eaf8fb6b63b064877fd183305288a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00432.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":44,"endLine":53,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":40,"startLine":53}}}],"message":{"text":"Found 'subprocess' function 'run' with 'shell=True'. This is dangerous because this call will spawn the command using a shell process. Doing so propagates current shell settings and variables, which makes it much easier for a malicious actor to execute commands. Use 'shell=False' instead."},"properties":{},"ruleId":"python.lang.security.audit.subprocess-shell-true.subprocess-shell-true"},{"fingerprints":{"matchBasedId/v1":"306d03220edc46a4f8c7824bd56a12df8af813811e9e74898ea40618da576af54a635bde9ab589babb0bd4cd39eeaea0b7e36b3018b38b23f7b5d30e20b33a57_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00433.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":46,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":46}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"ba58b9576a6465b8a5268d00668e0e12b2e3ef9e7c41c47216fcfdec4c97fea24f2575e1de9ccbae00041ca588c3d531ad65fae56ad5d40576cb475db136936e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00433.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":46,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":46}}}],"message":{"text":"Detected a possible YAML deserialization vulnerability. `yaml.unsafe_load`, `yaml.Loader`, `yaml.CLoader`, and `yaml.UnsafeLoader` are all known to be unsafe methods of deserializing YAML. An attacker with control over the YAML input could create special YAML input that allows the attacker to run arbitrary Python code. This would allow the attacker to steal files, download and install malware, or otherwise take over the machine. Use `yaml.safe_load` or `yaml.SafeLoader` instead."},"properties":{},"ruleId":"python.lang.security.deserialization.avoid-pyyaml-load.avoid-pyyaml-load"},{"fingerprints":{"matchBasedId/v1":"4af2b55794f19ad8d07d22fc078ef86562025ca5d6c1d3bdd7c555e34405310be29340dbe1ef27064a1f2249834a8d18c3b9e07499d3d4bb78f2f8cc1cef8df3_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00454.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":65,"endLine":41,"snippet":{"text":"\t\tsql = f'SELECT username from USERS where password = \\'{bar}\\''"},"startColumn":9,"startLine":41}}}],"message":{"text":"Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using the Django object-relational mappers (ORM) instead of raw SQL queries."},"properties":{},"ruleId":"python.django.security.injection.tainted-sql-string.tainted-sql-string"},{"fingerprints":{"matchBasedId/v1":"056d3b4a73c922ed8b9d8ae971fa17b9be19ce9bb908b352e6e917b3ab421cf52b39f0aa8853ab91af4bc14d28fb3cc026318a3a63c6207b25c17f4f38dd96c1_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00454.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":65,"endLine":41,"snippet":{"text":"\t\tsql = f'SELECT username from USERS where password = \\'{bar}\\''"},"startColumn":9,"startLine":41}}}],"message":{"text":"Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as SQLAlchemy which will protect your queries."},"properties":{},"ruleId":"python.flask.security.injection.tainted-sql-string.tainted-sql-string"},{"fingerprints":{"matchBasedId/v1":"91f92f5ce2606578a269b39304de5f3a6ab4606907e2cb3ebbb325cca21f32d9