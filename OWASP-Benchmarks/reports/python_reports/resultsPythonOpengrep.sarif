Loader=yaml.Loader)"},"startColumn":11,"startLine":43}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"9a9b2dc1a0fc0037e0508502c14ca652afa40c6c7d89f8e21f2b5444a3a1e02f7083ca39ef0012781b15be6d675cc94e92dc1cd8cd5266afc343458ee3b17f3b_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00827.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":43,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":43}}}],"message":{"text":"Detected a possible YAML deserialization vulnerability. `yaml.unsafe_load`, `yaml.Loader`, `yaml.CLoader`, and `yaml.UnsafeLoader` are all known to be unsafe methods of deserializing YAML. An attacker with control over the YAML input could create special YAML input that allows the attacker to run arbitrary Python code. This would allow the attacker to steal files, download and install malware, or otherwise take over the machine. Use `yaml.safe_load` or `yaml.SafeLoader` instead."},"properties":{},"ruleId":"python.lang.security.deserialization.avoid-pyyaml-load.avoid-pyyaml-load"},{"fingerprints":{"matchBasedId/v1":"1ac5c36af7f9689eea419c3d75cddbb3aa11b06f5fa193122e2eea1ce20e5522c92d4a257a80e755b7a5bdcfdb5a74ffba0ed27c546ede4a429783a76ad89169_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00843.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":52,"snippet":{"text":"\t\t\troot = ET.parse(f'{helpers.utils.RES_DIR}/employees.xml')"},"startColumn":11,"startLine":52}}}],"message":{"text":"The native Python `xml` library is 