rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"b775cdca7ee86e15b9f082d07ffd1934d0dc99a89463ef65a9801ef372bb6b24d337cc0d931d9802ee5fe9495419d9ad616efba2b3f2e17d58cb044fb9a4d6f8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00592.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":61,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":61}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"4d0f83a5840660f3dad6a548cc1b1ddeba0e8d5efa07b0a87442425c8e2d73dbf98c437c311df41099c32b2b383b1846aab32bae94629a0f69817f0be21726ad_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00592.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":65,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn":3,"startLine":62}}}],"message":{"text":"Found a Flask cookie with insecurely configured properties.  By default the secure, httponly and samesite ar configured insecurely. cookies should be handled securely by setting `secure=True`, `httponly=True`, and `samesite='Lax'` in response.set_cookie(...). If these parameters are not properly set, your cookies are not properly protected and are at risk of being stolen by an attacker. Include the `secure=True`, `httponly=True`, `samesite='Lax'` arguments or set these to be true in the Flask configuration."},"properties":{},"ruleId":"python.flask.security.audit.secure-set-cookie.secure-set-cookie"},{"fingerprints":{"matchBasedId/v1":"2964ce0eab2b577e55f8e0ae89bb650e5e5dc5720d285429f2d09deb92d3f6d29e5f109edf0c25c918fe88b17bf36a9f950ba98bf80bf2f93441c01595c55c3e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00593.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":59,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":59}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"ce32d90a651d2cd5660622e4d949e57c2014e25329c683201c76fe7d98cef4e3b57eee7b44112973d897d76ed0cc5c75c8f6fbb8a05011a5c94f402358bca1fc_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00593.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":63,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn"