hBasedId/v1":"81f776337e6dd4effd1d72b66bdaf1eb230cd3a31ce0faf5912468eba6334eb345353112079ee554cb94730a1a573314990f9e830770238b08a965aa57fcc680_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00251.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":24,"endLine":59,"snippet":{"text":"\t\thash = hashlib.sha1()"},"startColumn":10,"startLine":59}}}],"message":{"text":"Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant and is therefore not suitable as a cryptographic signature. Use SHA256 or SHA3 instead."},"properties":{},"ruleId":"python.lang.security.insecure-hash-algorithms.insecure-hash-algorithm-sha1"},{"fingerprints":{"matchBasedId/v1":"bee723b33f5f7f3fda86dc4a85871bf356c1bfd1ff90e7780b12aad6a88dbe7aa8287e831605c2f9fdc08e8432c95b772cac00d006e773cf7d51c7fc22369b8f_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00256.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":72,"endLine":48,"snippet":{"text":"\t\tRESPONSE = make_response((RESPONSE, {'yourBenchmarkTest00256': bar}))"},"startColumn":14,"startLine":48}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"b2fa42a2a7493538a2aeeee91e032afd8d613865197ac33a6a7e0c7c7aca706bde1ba525f7d8ab6dfcf77a50038de68271acc0c7d7417f37480bcd3ccbe28dd8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00257.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":72,"endLine":44,"snippet":{"text":"\t\tRESPONSE = make_response((RESPONSE, {'yourBenchmarkTest00257': bar}))"},"startColumn":14,"startLine":44}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"10b9f8fb16f8ac5082fa680aa659dc6b46ff6ae64bc92a9c5518a2f9c75a31dcaad728eedc15108755a463756cfc2c4916012c71d29ca84140be8a87ad6d4ef3_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00263.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":52,"snippet":{"text":"\t\t\tRESPONSE += (\n\t\t\t\teval(bar)\n\t\t\t)"},"startColumn":16,"startLine":50}}}],"message":{"text":"Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.eval-detected.eval-detected"},{"fingerprints":{"matchBasedId/v1":"de4763efab7f0837769cd35a561729c713271a89302da32f3e7a985b10ba5362ef9725614530e0ac7ffb7397ef1fdf04e9a02b728ff6b4e97a10ff655d25174e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00264.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":13,"endLine":44,"snippet":{"text":"\t\t\texec(bar)"},"startColumn":4,"startLine":44}}}],"message":{"text":"Detected the use of exec(). exec() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.exec-detected.exec-detected"},{"fingerprints":{"matchBasedId/v1":"e47f0acc24777cef8bb5fb45d932175973b875e7eaf5c5153aaaaf1f2e19aa0b09fd6fc4bf14871837e6f153775f8564c9484d0f5748a36a31cd7f969806210e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00269.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":44,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":44}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"88e190084238152f17342697150660a4cf2b29ca16a14bb7f13598e1c393baa46e2b480c095fdf131e400e6a49bbc8a7d92e995ac79b8ee2ad9c1e75c8a7ee94_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00269.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":44,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":44}}}],"message":{"text":"Detected a possible YAML deserialization vulnerability. `yaml.unsafe_load`, `yaml.Loader`, `yaml.CLoader`, and `yaml.UnsafeLoader` are all known to be unsafe methods of deserializing YAML. An attacker with control over the YAML input could create special YAML input that allows the attacker to run arbitrary Python code. This would allow the attacker to steal files, download and install malware, or otherwise take over the machine. Use `yaml.safe_load` or `yaml.SafeLoader` instead."},"properties":{},"ruleId":"python.lang.security.deserialization.avoid-pyyaml-load.avoid-pyyaml-load"},{"fingerprints":{"matchBasedId/v1":"67bdca9ec2dbbea0ef573530860c1adcd935c979edaac19985ccb5658895ce95fc3cfafbecf45d6de5a4bd0c1983ea934407b8cef66940e23532dd845e2f483f_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00270.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":41,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":41}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"c6ca355a859c8a94dfc232955a5713f31f0a4f52935e79f726a4ad893124bebea5be36c82ebdf302c234869993f754a2c4c375396581757e29b29ab1afd5d314_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00270.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":41,"snippet":{"text":"\t\t\tyobj = yaml.load(bar, Loader=yaml.Loader)"},"startColumn":11,"startLine":41}}}],"message":{"text":"Detected a possible YAML deserialization vulnerability. `yaml.unsafe_load`, `yaml.Loader`, `yaml.CLoader`, and `yaml.UnsafeLoader` are all known to be unsafe methods of deserializing YAML. An attacker with control over the YAML input could create special YAML input that allows the attacker to run arbitrary Python code. This would allow the attacker to steal files, download and install malware, or otherwise take over the machine. Use `yaml.safe_load` or `yaml.SafeLoader` instead."},"properties":{},"ruleId":"python.lang.security.deserialization.avoid-pyyaml-load.avoid-pyyaml-load"},{"fingerprints":{"matchBasedId/v1":"c677efd0074245f18890a039efb55fa6a78159993e8aa0e05e4b1cd1dfd49359282e40e35d887e6e668baee4faa7fb17a5e705c8d467ce6e8f4db4de7708f198_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00283.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":19,"endLine":49,"snippet":{"text":"\t\tcur.execute(sql)"},"startColumn":3,"startLine":49}}}],"message":{"text":"Detected possible formatted SQL query. Use parameterized queries instead."},"properties":{},"ruleId":"python.lang.security.audit.formatted-sql-query.formatted-sql-query"},{"fingerprints":{"matchBasedId/v1":"64a5d587ea63ba85455d0bbc7200fa4ea280ccb36f6584fa9644b427605321d86daf81b258ee34efe2f93cbf9f8ce319f88b637798e1f73c08f4f7ee5bcd6fc4_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00283.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":19,"endLine":49,"snippet":{"text":"\t\tcur.execute(sql)"},"startColumn":3,"startLine":49}}}],"message":{"text":"Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. In order to execute raw query safely, prepared statement should be used. SQLAlchemy provides TextualSQL to easily used prepared statement with named parameters. For complex SQL composition, use SQL Expression Language or Schema Definition Language. In most cases, SQLAlchemy ORM will be a better option."},"properties":{},"ruleId":"python.sqlalchemy.security.sqlalchemy-execute-raw-query.sqlalchemy-execute-raw-query"},{"fingerprints":{"matchBasedId/v1":"b8646c7e45fa9297147daf3286a776d19a71e25363652ecf4eec7fedb89fa378892cbe92bc808a79b0d45daa1c308699c3e8d164a0af55be561fbf2e8a969c92_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00284.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":19,"endLine":47,"snippet":{"text":"\t\tcur.execute(sql)"},"startColumn":3,"startLine":47}}}],"message":{"text":"Detected possible formatted SQL query. Use parameterized queries instead."},"properties":{},"ruleId":"python.lang.security.audit.formatted-sql-query.formatted-sql-query"},{"fingerprints":{"matchBasedId/v1":"ee3f8ef28ddeab8f6fc452574b8d0cb50e71b931950b747e71681b2bbf104ad98cfd1868108f618c0611d472fe777bc9f93808b466771db2a3af43ec83b12408_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00284.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":19,"endLine":47,"snippet":{"text":"\t\tcur.execute(sql)"},"startColumn":3,"startLine":47}}}],"message":{"text":"Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. In order to execute raw query safely, prepared statement should be used. SQLAlchemy provides TextualSQL to easily used prepared statement with named parameters. For complex SQL composition, use SQL Expression Language or Schema Definition Language. In most cases, SQLAlchemy ORM will be a better option."},"properties":{},"ruleId":"python.sqlalchemy.security.sqlalchemy-execute-raw-query.sqlalchemy-execute-raw-query"},{"fingerprints":{"matchBasedId/v1":"91809e388940e8574a89d9cbc5c1269929b5f006db0c85b5c7525be641ff7addc7656cf314ec0f6badaf48543af0ce37e8c2837efa7c2f530d2db0aa86522041_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00288.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":50,"snippet":{"text":"\t\t\troot = ET.parse(f'{helpers.utils.RES_DIR}/employees.xml')"},"startColumn":11,"startLine":50}}}],"message":{"text":"The native Python `xml` library is vulnerable to XML External Entity (XXE) attacks.  These attacks can leak confidential data and \"XML bombs\" can cause denial of service. Do not use this library to parse untrusted input. Instead  the Python documentation recommends using `defusedxml`."},"properties":{},"ruleId":"python.lang.security.use-defused-xml-parse.use-defused-xml-parse"},{"fingerprints":{"matchBasedId/v1":"326f90f8d684cc3c5765325e1993318e1bb80b94b31