cated. Consider using 'SHA256' or a similar function instead."},"properties":{},"ruleId":"python.lang.security.insecure-hash-function.insecure-hash-function"},{"fingerprints":{"matchBasedId/v1":"304bcb72388d1c6231aeff12a18fe47bf0013c663eb687d8062c3dec52b1df3e3c72702baefd25619b6ac22a345d63a870ca50f8ea06f835f14e73733fb9ad3d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00980.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":65,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":65}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"f50ef30771f2c661117213fdd682085786002bb553ebfdefea5cbae6e0f6135164cc09d103af6db9ef37acf0c53f761f2149524af47f3820a9af0e1dc0ee525c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00980.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":69,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn":3,"startLine":66}}}],"message":{"text":"Found a Flask cookie with insecurely configured properties.  By default the secure, httponly and samesite ar configured insecurely. cookies should be handled securely by setting `secure=True`, `httponly=True`, and `samesite='Lax'` in response.set_cookie(...). If these parameters are not properly set, your cookies are not properly protected and are at risk of being stolen by an attacker. Include the `secure=True`, `httponly=True`, `samesite='Lax'` arguments or set these to be true in the Flask configuration."},"properties":{},"ruleId":"python.flask.security.audit.secure-set-cookie.secure-set-cookie"},{"fingerprints":{"matchBasedId/v1":"70d8afbecdfe66da946de0d7c850973b617056c6ffaaff9244a58452bc375211c27d638d78d0db45c25e2c73aae14df8bf288cca0ac045430bf720ac34a811ee_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00981.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":70,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":70}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"39ad0f0ff629b14564d62ab7fa8a7de3bf8c1a1d2feca432b0f4bf4a1ff98a11a3b2512c344336029528139acc3bbbbc64ea4287949ab8cdb1766079c5c06f59_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00981.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":74,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn":3,"startLine":71}}}],"message":{"text":"Found a Flask cookie with insecurely configured properties.  By default the secure, httponly and samesite ar configured insecurely. cookies should be handled securely by setting `secure=True`, `httponly=True`, and `samesite='Lax'` in response.set_cookie(...). If these parameters are not properly set, your cookies are not properly protected and are at risk of being stolen by an attacker. Include the `secure=True`, `httponly=True`, `samesite='Lax'` arguments or set these to be true in the Flask configuration."},"properties":{},"ruleId":"python.flask.security.audit.secure-set-cookie.secure-set-cookie"},{"fingerprints":{"matchBasedId/v1":"90f36ab2f67222a7edd4311ddc4fd844b2ae84d9be685fdb9599a120e789a38a8e015d10351afcc610cf77e396f2a37fbc40f15a6229a8bf9458081de200bc1e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00986.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":56,"snippet":{"text":"\t\t\tRESPONSE += (\n\t\t\t\teval(bar)\n\t\t\t)"},"startColumn":16,"startLine":54}}}],"message":{"text":"Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.eval-detected.eval-detected"},{"fingerprints":{"matchBasedId/v1":"df7b140554601b15262d831a14df7e59705087c707f302f410488425081923d26ded6a790c90afecbeb66a64262a9cb154f095a84e5d6767ac6ad47b36ebf26c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00987.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":62,"snippet":{"text":"\t\t\tRESPONSE += (\n\t\t\t\teval(bar)\n\t\t\t)"},"startColumn":16,"startLine":60}}}],"message":{"text":"Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.eval-detected.eval-detected"},{"fingerprints":{"matchBasedId/v1":"b82863560ff8c3a8186214aedee6b5e0355d7b68f14c3e4359a7173d3e460