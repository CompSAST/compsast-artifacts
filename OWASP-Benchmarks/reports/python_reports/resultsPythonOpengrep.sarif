Location":{"artifactLocation":{"uri":"testcode/BenchmarkTest00471.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":72,"snippet":{"text":"\t\tparam = request.headers.get(\"BenchmarkTest00471\")\n\t\tif not param:\n\t\t    param = \"\"\n\n\t\tpossible = \"ABC\"\n\t\tguess = possible[1]\n\t\t\n\t\tmatch guess:\n\t\t\tcase 'A':\n\t\t\t\tbar = param\n\t\t\tcase 'B':\n\t\t\t\tbar = 'bob'\n\t\t\tcase 'C' | 'D':\n\t\t\t\tbar = param\n\t\t\tcase _:\n\t\t\t\tbar = 'bob\\'s your uncle'\n\n\t\timport lxml.etree\n\t\timport helpers.utils\n\t\timport io\n\n\t\ttry:\n\t\t\tfd = open(f'{helpers.utils.RES_DIR}/employees.xml', 'rb')\n\t\t\troot = lxml.etree.parse(fd)\n\t\t\tstrIO = io.StringIO()\n\t\t\tstrIO.write('/Employees/Employee[@emplid=\\'')\n\t\t\tstrIO.write(bar)\n\t\t\tstrIO.write('\\']')\n\t\t\tquery = strIO.getvalue()\n\n\t\t\tnodes = root.xpath(query)\n\t\t\tnode_strings = []\n\t\t\tfor node in nodes:\n\t\t\t\tnode_strings.append(' '.join([e.text for e in node]))\n\n\t\t\tRESPONSE += (\n\t\t\t\tf'Your XPATH query results are: <br>[ {', '.join(node_strings)} ]'\n\t\t\t)\n\t\texcept:\n\t\t\tRESPONSE += (\n\t\t\t\tf'Error parsing XPath Query: \\'{escape_for_html(query)}\\''\n\t\t\t)"},"startColumn":3,"startLine":31}}}],"message":{"text":"Found user-controlled request data passed into '.write(...)'. This could be dangerous if a malicious actor is able to control data into sensitive files. For example, a malicious actor could force rolling of critical log files, or cause a denial-of-service by using up available disk space. Instead, ensure that request data is properly escaped or sanitized."},"properties":{},"ruleId":"python.django.security.injection.request-data-write.request-data-write"},{"fingerprints":{"matchBasedId/v1":"de3b5c1eb36ee8bea98a8edb0ccdd5ab9239e5f5190dfdadaa5c2a04899951970800c35019ab37c45d88d73e58f9bf7ed85383e6cd4f12a7e526b6e961c98d6c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00472.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":64,"snippet":{"text":"\t\tparam = request.headers.get(\"BenchmarkTest00472\")\n\t\tif not param:\n\t\t    param = \"\"\n\n\t\timport helpers.ThingFactory\n\t\t\n\t\tthing = helpers.ThingFactory.createThing()\n\t\tbar = thing.doSomething(param)\n\n\t\timport lxml.etree\n\t\timport helpers.utils\n\t\timport io\n\n\t\ttry:\n\t\t\tfd = open(f'{helpers.utils.RES_DIR}/employees.xml', 'rb')\n\t\t\troot = lxml.etree.parse(fd)\n\t\t\tstrIO = io.StringIO()\n\t\t\tstrIO.write('/Employees/Employee[@emplid=\\'')\n\t\t\tstrIO.write(bar)\n\t\t\tstrIO.write('\\']')\n\t\t\tquery = strIO.getvalue()\n\n\t\t\tnodes = root.xpath(query)\n\t\t\tnode_strings = []\n\t\t\tfor node in nodes:\n\t\t\t\tnode_strings.append(' '.join([e.text for e in node]))\n\n\t\t\tRESPONSE += (\n\t\t\t\tf'Your XPATH query results are: <br>[ {', '.join(node_strings)} ]'\n\t\t\t)\n\t\texcept:\n\t\t\tRESPONSE += (\n\t\t\t\tf'Error parsing XPath Query: \\'{escape_for_html(query)}\\''\n\t\t\t)"},"startColumn":3,"startLine":31}}}],"message":{"text":"Found user-controlled request data passed into '.write(...)'. This could be dangerous if a malicious actor is able to control data into sensitive files. For example, a malicious actor could force rolling of critical log files, or cause a denial-of-service by using up available disk space. Instead, ensure that request data is properly escaped or sanitized."},"properties":{},"ruleId":"python.django.security.injection.request-data-write.request-data-write"},{"fingerprints":{"matchBasedId/v1":"4c8cec56c8fa03bcc97aaf5f8e318fe7e029abd6a8162f269360486b98099a4f802240c2b6d503adace194691052f0b5a6b806321ab1ed839cc7a5b4dfba1771_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00482.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":28,"endLine":58,"snippet":{"text":"\t\thash = hashlib.new('md5')"},"startColumn":10,"startLine":58}}}],"message":{"text":"Detected use of an insecure MD4 or MD5 hash function. These functions have known vulnerabilities and are considered deprecated. Consider using 'SHA256' or a similar function instead."},"properties":{},"ruleId":"python.lang.security.insecure-hash-function.insecure-hash-function"},{"fingerprints":{"matchBasedId/v1":"03fdf07151e943c33c18baa8fbd02bd4842cfe64db65541de22e2814f34b6fd96322efe860cbe78856c6080cf5bb19ecf16205636c4ee717c54d94cf08441d83_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00493.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":72,"endLine":48,"snippet":{"text":"\t\tRESPONSE = make_response((RESPONSE, {'yourBenchmarkTest00493': bar}))"},"startColumn":14,"startLine":48}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"b87e30ef3d005187ed4e75a5618ac230da717d8441c2c352b95de2e96184defa125051bb5685ffc9dc259da355f56416599068f1fb6f410e05de47aab9e9c2da_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00494.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":56,"snippet":{"text":"\t\tRESPONSE = make_response(RESPONSE)"},"startColumn":14,"startLine":56}}}],"message":{"text":"Be careful with `flask.make_response()`. If this response is rendered onto a webpage, this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write your HTML in a template file and use `flask.render_template()` which will take care of escaping. If you are returning data from an API, consider using `flask.jsonify()`."},"properties":{},"ruleId":"python.flask.security.audit.xss.make-response-with-unknown-content.make-response-with-unknown-content"},{"fingerprints":{"matchBasedId/v1":"84e8c859258d6de4fc1e5c45913f964685b46ad60958e16c4a1385b7fe9c9e3fd706a1d6d39f6da6a821b957f77da25c42227671c6735fb0d9a2a0adb84139e2_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00494.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":18,"endLine":60,"snippet":{"text":"\t\tRESPONSE.set_cookie(cookie, value,\n\t\t\tpath=request.path,\n\t\t\tsecure=False,\n\t\t\thttponly=True)"},"startColumn":3,"startLine":57}}}],"message":{"text":"Found a Flask cookie with insecurely configured properties.  By default the secure, httponly and samesite ar configured insecurely. cookies should be handled securely by setting `secure=True`, `httponly=True`, and `samesite='Lax'` in response.set_cookie(...). If these parameters are not properly set, your cookies are not properly protected and are at risk of being stolen by an attacker. Include the `secure=True`, `httponly=True`, `samesite='Lax'` arguments or set these to be true in the Flask configuration."},"properties":{},"ruleId":"python.flask.security.audit.secure-set-cookie.secure-set-cookie"},{"fingerprints":{"matchBasedId/v1":"35024182030e44eec0ac05e3cbe538f536ba10cdf44496911bf2d090260d508c2c56e19d6cc01f143276e226f2bea8d92166cf73f735a009d5ca0edfdf924023_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00503.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":42,"snippet":{"text":"\t\t\tRESPONSE += (\n\t\t\t\teval(bar)\n\t\t\t)"},"startColumn":16,"startLine":40}}}],"message":{"text":"Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.eval-detected.eval-detected"},{"fingerprints":{"matchBasedId/v1":"63916135c9443850ab49dba3ce6a720d869955158c62e8d3e100a44a66d3a68519374f89ee58fba0c6264add8c17f857c74c62e032a33a211b5760a58818569e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00504.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":49,"snippet":{"text":"\t\t\tRESPONSE += (\n\t\t\t\teval(bar)\n\t\t\t)"},"startColumn":16,"startLine":47}}}],"message":{"text":"Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."},"properties":{},"ruleId":"python.lang.security.audit.eval-detected.eval-detected"},{"fingerprints":{"matchBasedId/v1":"41c374f14a107267a94806e2fcae91d32b88495886dccc9042bd0cfe6abe57fd6d7b5f5c406c620cf1af193e4aaf5889c5a2ecb9a3413f9c5d07606cbf6ad516_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00507.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":59,"endLine":55,"snippet":{"text":"\t\t\tunpickled = pickle.loads(base64.urlsafe_b64decode(bar))"},"startColumn":16,"startLine":55}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"5872f64a0b9f345ecfe240369a3d354db20e762c6131f25282822607dfdd57edc1369c0a78f38e8287ecf27134c2e01e59ee40b1cbb19e9cbb867993b156848a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00507.