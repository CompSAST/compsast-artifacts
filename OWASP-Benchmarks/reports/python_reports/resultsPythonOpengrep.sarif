dbc18b7ae0c5605b4335c7ed1734272937579dfb5de819e9b8658d824cd11e08d7754b0594c482fcb0373e69cfbdb245f8c9287b8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00164.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":59,"endLine":47,"snippet":{"text":"\t\t\tunpickled = pickle.loads(base64.urlsafe_b64decode(bar))"},"startColumn":16,"startLine":47}}}],"message":{"text":"Detected the use of an insecure deserialization library in a Flask route. These libraries are prone to code execution vulnerabilities. Ensure user data does not enter this function. To fix this, try to avoid serializing whole objects. Consider instead using a serializer such as JSON."},"properties":{},"ruleId":"python.flask.security.insecure-deserialization.insecure-deserialization"},{"fingerprints":{"matchBasedId/v1":"8ac8d4cd2a7bd3168a018aca4f77b7b8ae75ab44dc6d904f9fa1cf95b9ee9a2cd7c15c6c7e5cc320eee793de6733bb2d2acd8f1eddf908f1699e3e1abd79a41f_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00164.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":59,"endLine":47,"snippet":{"text":"\t\t\tunpickled = pickle.loads(base64.urlsafe_b64decode(bar))"},"startColumn":16,"startLine":47}}}],"message":{"text":"Avoid using `pickle`, which is known to lead to code execution vulnerabilities. When unpickling, the serialized data could be manipulated to run arbitrary code. Instead, consider serializing the relevant data as JSON or a similar text-based serialization format."},"properties":{},"ruleId":"python.lang.security.deserialization.pickle.avoid-pickle"},{"fingerprints":{"matchBasedId/v1":"72f8899c91aee2a811c08700c2bc9afd6bfeedeef59f2a31a66fb4a9782440dd3241283c86e1dfd3739ef98f0e92de639369ff27da91acbe866620cec317204c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00166.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":84,"endLine":53,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":11,"startLine":53}}}],"message":{"text":"Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability. An attacker could use this vulnerability to execute arbitrary commands on the host, which allows them to download malware, scan sensitive data, or run any command they wish on the server. Do not let users choose the command to run. In general, prefer to use Python API versions of system commands. If you must use subprocess, use a dictionary to allowlist a set of commands."},"properties":{},"ruleId":"python.flask.security.injection.subprocess-injection.subprocess-injection"},{"fingerprints":{"matchBasedId/v1":"ac847976bb5e1cb5c9ab9b65089e6072024f112f3a919a5b3ca412097417056944d2490e7816e2ba571db9b32b240560640cbee060240c81898988188a93ec80_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00166.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":32,"endLine":53,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":26,"startLine":53}}}],"message":{"text":"Detected subprocess function 'run' with user controlled data. A malicious actor could leverage this to perform command injection. You may consider using 'shlex.escape()'."},"properties":{},"ruleId":"python.lang.security.dangerous-subprocess-use.dangerous-subprocess-use"},{"fingerprints":{"matchBasedId/v1":"ff2672fc4b9d8e96743feeb1a3165cea32e0353e82d3313279ca988f59e451aafb4f812b055bbfdef2602ab0c1258379121c413e27597a95f05cbcf4922511d5_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00166.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":44,"endLine":53,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":40,"startLine":53}}}],"message":{"text":"Found 'subprocess' function 'run' with 'shell=True'. This is dangerous because this call will spawn the command using a shell process. Doing so propagates current shell settings and variables, which makes it much easier for a malicious actor to execute commands. Use 'shell=False' instead."},"properties":{},"ruleId":"python.lang.security.audit.subprocess-shell-true.subprocess-shell-true"},{"fingerprints":{"matchBasedId/v1":"0aae1fd0ab664cd5e3fa6c3a4470c337cc8f80fce603fa163a248e99eff9901b66318d88db0e7162dc9c9f2a40419c79997777768e1e7e4fc1a8aff662c6a19b_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00167.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":84,"endLine":53,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":11,"startLine":53}}}],"message":{"text":"Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability. An attacker could use this vulnerability to execute arbitrary commands on the host, which allows them to download malware, scan sensitive data, or run any command they wish on the server. Do not let users choose the command to run. In general, prefer to use Python API versions of system commands. If you must use subprocess, use a dictionary to allowlist a set of commands."},"properties":{},"ruleId":"python.flask.security.injection.subprocess-injection.subprocess-injection"},{"fingerprints":{"matchBasedId/v1":"ea426c2677c9aa2d760edb0931e1981af56c9d4494e31691cb6a1828b07c70d438996864f95f7f4a2b15810983068a6f9459cbde299f93c61d974507ce296fc4_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest00167.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":32,"endLine":53,"snippet":{"text":"\t\t\tproc = subprocess.run(argStr, shell=True, capture_output=True, encoding=\"utf-8\")"},"startColumn":26,"startLine":53}}}],"message":{"text":"Detected subprocess function 'run' with user controlled data. A malicious actor could leverage 