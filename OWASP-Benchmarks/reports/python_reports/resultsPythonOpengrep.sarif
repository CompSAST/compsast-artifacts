quest is passed to redirect(). This is an open redirect and could be exploited. Consider using 'url_for()' to generate links to known locations. If you must use a URL to unknown pages, consider using 'urlparse()' or similar and checking if the 'netloc' property is the same as your site's host name. See the references for more information."},"properties":{},"ruleId":"python.flask.security.open-redirect.open-redirect"},{"fingerprints":{"matchBasedId/v1":"b391ea2a7103eac6f4faa15cf3c40ca5de3078ef2bf50bd93b67272533952d3763e5f8a32bfaf327961bd59aafda08877676294fbbb2dd45a135403e2d6ea0aa_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest01209.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":31,"endLine":52,"snippet":{"text":"\t\tparam = request.args.get(\"BenchmarkTest01209\")\n\t\tif not param:\n\t\t\tparam = \"\"\n\n\n\t\timport flask\n\t\timport urllib.parse\n\n\t\ttry:\n\t\t\turl = urllib.parse.urlparse(param)\n\t\t\tif url.netloc not in ['google.com'] or url.scheme != 'https':\n\t\t\t\tRESPONSE += (\n\t\t\t\t\t'Invalid URL.'\n\t\t\t\t)\n\t\t\t\treturn RESPONSE\n\t\texcept:\n\t\t\tRESPONSE += (\n\t\t\t\t'Error parsing URL.'\n\t\t\t)\n\t\t\treturn RESPONSE\n\n\t\treturn flask.redirect(param)"},"startColumn":3,"startLine":31}}}],"message":{"text":"Data from request is passed to redirect(). This is an open redirect and could be exploited. Consider using 'url_for()' to generate links to known locations. If you must use a URL to unknown pages, consider using 'urlparse()' or similar and checking if the 'netloc' property is the same as your site's host name. See the references for more information."},"properties":{},"ruleId":"python.flask.security.open-redirect.open-redirect"},{"fingerprints":{"matchBasedId/v1":"d62f5f65aec4b2a512ba9d805b114ef2213b3d0b8bf3c187802f1c207922882cdb91791ae30a501b8e9981e8415b21ad7b9e753898713bdb5e70e46dbca98b54_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"testcode/BenchmarkTest01211.py","uriB