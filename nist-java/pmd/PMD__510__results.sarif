      "tool": {
        "driver": {
          "name": "PMD",
          "version": "6.55.0",
          "informationUri": "https://pmd.github.io/pmd/",
          "rules": [
            {
              "id": "UnconditionalIfStatement",
              "shortDescription": {
                "text": "Do not use if statements that are always true or always false"
              },
              "fullDescription": {
                "text": "\nDo not use \"if\" statements whose conditionals are always true or always false.\n        "
              },
              "helpUri": "https://pmd.github.io/pmd-6.55.0/pmd_rules_java_errorprone.html#unconditionalifstatement",
              "help": {
                "text": "\nDo not use \"if\" statements whose conditionals are always true or always false.\n        "
              },
              "properties": {
                "ruleset": "Error Prone",
                "priority": 3,
                "tags": [
                  "Error Prone"
                ]
              }
            },
            {
              "id": "AvoidBranchingStatementAsLastInLoop",
              "shortDescription": {
                "text": "Avoid using a branching statement as the last in a loop."
              },
              "fullDescription": {
                "text": "\nUsing a branching statement as the last part of a loop may be a bug, and/or is confusing.\nEnsure that the usage is not a bug, or consider using another approach.\n        "
              },
              "helpUri": "https://pmd.github.io/pmd-6.55.0/pmd_rules_java_errorprone.html#avoidbranchingstatementaslastinloop",
              "help": {
                "text": "\nUsing a branching statement as the last part of a loop may be a bug, and/or is confusing.\nEnsure that the usage is not a bug, or consider using another approach.\n        "
              },
              "properties": {
                "ruleset": "Error Prone",
                "priority": 2,
                "tags": [
                  "Error Prone"
                ]
              }
            },
            {
              "id": "AvoidUsingHardCodedIP",
              "shortDescription": {
                "text": "Do not hard code the IP address "
              },
              "fullDescription": {
                "text": "\nApplication with hard-coded IP addresses can become impossible to deploy in some cases.\nExternalizing IP adresses is preferable.\n        "
              },
              "helpUri": "https://pmd.github.io/pmd-6.55.0/pmd_rules_java_bestpractices.html#avoidusinghardcodedip",
              "help": {
                "text": "\nApplication with hard-coded IP addresses can become impossible to deploy in some cases.\nExternalizing IP adresses is preferable.\n        "
              },
              "properties": {
                "ruleset": "Best Practices",
                "priority": 3,
                "tags": [
                  "Best Practices"
                ]
              }
            }
          ]
        }
      },
